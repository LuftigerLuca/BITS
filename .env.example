# Copy to .env and fill in. Docker Compose reads .env automatically.

# Shared secret the bot uses to call the backend API. At least 32 characters, e.g. `openssl rand -hex 32`; the
# backend does not start with a placeholder.
BITS_SERVICE_TOKEN=

# Bot token from the Discord developer portal and the ID of the guild the bot serves. Only members of this
# guild can log in to the dashboard.
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# OAuth2 client of the same Discord application (OAuth2 → Client information), for the dashboard login.
# Add <BITS_PUBLIC_URL>/auth/oauth2/callback/discord as a redirect URI there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Origin the dashboard is reached under. The Discord login redirects back to it.
BITS_PUBLIC_URL=http://localhost:5173

# Key the dashboard sessions are signed with, at least 32 characters, e.g. `openssl rand -hex 32`.
BITS_JWT_SECRET=

# Optional admin account that works without Discord; leave both empty to disable it. The hash is BCrypt,
# e.g. `htpasswd -nbBC 12 "" 'password' | cut -d: -f2`. Keep the single quotes, otherwise Docker Compose
# reads the `$` in the hash as variables.
BITS_ADMIN_USERNAME=
BITS_ADMIN_PASSWORD_HASH=''

POSTGRES_PASSWORD=bits
